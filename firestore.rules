rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function hasVerifiedEmail() {
      return isSignedIn() && request.auth.token.get('email_verified', false) == true &&
             request.auth.token.get('email', '') is string &&
             request.auth.token.get('email', '').matches('^[^/]+$');
    }

    function isAdminUserProfileData(data) {
      return data.get('role', 'regular') == 'admin' &&
             (!('email' in data) || data.email == '' || data.email.lower() == request.auth.token.email.lower());
    }

    function hasAdminUserDoc() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             isAdminUserProfileData(get(/databases/$(database)/documents/users/$(request.auth.uid)).data);
    }

    function isAdminEmailDocData(data) {
      return data.get('role', 'regular') == 'admin' || data.get('enabled', false) == true;
    }

    function hasAdminEmailDoc() {
      return exists(/databases/$(database)/documents/admin_emails/$(request.auth.token.email.lower())) &&
             isAdminEmailDocData(get(/databases/$(database)/documents/admin_emails/$(request.auth.token.email.lower())).data);
    }

    function isAdmin() {
      return hasVerifiedEmail() && (hasAdminUserDoc() || hasAdminEmailDoc());
    }

    function isValidLanguage(lang) {
      return lang is string && lang in ['en', 'ceb', 'tl', 'es'];
    }

    function isValidAttractionCategory(cat) {
      return cat is string && cat.size() >= 2 && cat.size() <= 40 && cat.matches('^[A-Z0-9_]+$') && cat != 'ALL';
    }

    function isValidCategoryIconKey(iconKey) {
      return iconKey is string && iconKey.size() >= 1 && iconKey.size() <= 32 && iconKey.matches('^[a-z0-9_]+$');
    }

    function isValidAttractionCategoryRecord(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             isValidAttractionCategory(data.code) &&
             data.name is string && data.name.size() >= 2 && data.name.size() <= 50 &&
             isValidCategoryIconKey(data.iconKey) &&
             data.sortOrder is int && data.sortOrder >= 0 && data.sortOrder <= 999 &&
             data.visibility is string && data.visibility == 'public' &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidEmergencyPriority(priority) {
      return priority is string && priority in ['CRITICAL', 'HIGH', 'MEDICAL', 'STANDARD'];
    }

    function isValidTransitMode(mode) {
      return mode is string && mode in ['TRICYCLE', 'HABAL_HABAL', 'BUS_VAN', 'JEEPNEY_MULTICAB'];
    }

    function isValidServiceStatus(status) {
      return status is string && status in ['OPERATIONAL', 'LIMITED', 'ADVISORY'];
    }

    function isValidUserProfile(data) {
      return data.userId is string &&
             data.userId == request.auth.uid &&
             (!('email' in data) || (data.email is string && data.email.size() <= 160 &&
               (data.email == '' || (request.auth.token.get('email', '') is string && data.email.lower() == request.auth.token.email.lower())))) &&
             (!('role' in data) || (data.role is string && data.role in ['regular', 'admin'])) &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80 &&
             (!('photoData' in data) || (data.photoData is string && data.photoData.size() <= 65536)) &&
             (!('favoriteAttractionIds' in data) || (data.favoriteAttractionIds is list && data.favoriteAttractionIds.size() <= 100)) &&
             isValidLanguage(data.preferredLanguage) &&
             data.offlinePackEnabled is bool &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidAttraction(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.mapNodeId is string && data.mapNodeId.size() >= 1 && data.mapNodeId.size() <= 80 &&
             data.nameEn is string && data.nameEn.size() >= 2 && data.nameEn.size() <= 120 &&
             (!('nameCeb' in data) || (data.nameCeb is string && data.nameCeb.size() <= 120)) &&
             (!('nameTl' in data) || (data.nameTl is string && data.nameTl.size() <= 120)) &&
             (!('nameEs' in data) || (data.nameEs is string && data.nameEs.size() <= 120)) &&
             data.subtitleEn is string && data.subtitleEn.size() >= 2 && data.subtitleEn.size() <= 160 &&
             data.descriptionEn is string && data.descriptionEn.size() >= 5 && data.descriptionEn.size() <= 1200 &&
             (!('historyNoteEn' in data) || (data.historyNoteEn is string && data.historyNoteEn.size() <= 1000)) &&
             data.barangay is string && data.barangay.size() >= 2 && data.barangay.size() <= 80 &&
             isValidAttractionCategory(data.category) &&
             data.latitude is number && data.latitude >= -90 && data.latitude <= 90 &&
             data.longitude is number && data.longitude >= -180 && data.longitude <= 180 &&
             data.openHours is string && data.openHours.size() >= 2 && data.openHours.size() <= 100 &&
             data.entryFeeEn is string && data.entryFeeEn.size() >= 1 && data.entryFeeEn.size() <= 120 &&
             data.bestTimeEn is string && data.bestTimeEn.size() >= 1 && data.bestTimeEn.size() <= 120 &&
             data.transitHintEn is string && data.transitHintEn.size() >= 1 && data.transitHintEn.size() <= 240 &&
             data.baseRating is number && data.baseRating >= 1 && data.baseRating <= 5 &&
             data.imageKey is string && data.imageKey.size() >= 1 && data.imageKey.size() <= 40 &&
             (!('photoData' in data) || (data.photoData is string && data.photoData.size() <= 65536)) &&
             (!('galleryPhotos' in data) || (data.galleryPhotos is list && data.galleryPhotos.size() <= 4)) &&
             data.visibility is string && data.visibility == 'public' &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidEmergencyContact(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.titleEn is string && data.titleEn.size() >= 2 && data.titleEn.size() <= 140 &&
             data.department is string && data.department.size() >= 2 && data.department.size() <= 160 &&
             data.phoneNumber is string && data.phoneNumber.size() >= 2 && data.phoneNumber.size() <= 40 &&
             data.availability is string && data.availability.size() >= 2 && data.availability.size() <= 100 &&
             isValidEmergencyPriority(data.priorityLevel) &&
             (!('email' in data) || (data.email is string && data.email.size() <= 120)) &&
             (!('websiteUrl' in data) || (data.websiteUrl is string && data.websiteUrl.size() <= 240)) &&
             data.visibility is string && data.visibility == 'public' &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidItineraryItem(data) {
      return data.userId is string &&
             data.userId == request.auth.uid &&
             data.attractionId is string && data.attractionId.size() >= 1 && data.attractionId.size() <= 80 &&
             data.attractionName is string && data.attractionName.size() >= 1 && data.attractionName.size() <= 120 &&
             data.plannedDateMillis is int && data.plannedDateMillis >= 0 &&
             (!('notes' in data) || (data.notes is string && data.notes.size() <= 500)) &&
             data.reminderEnabled is bool &&
             data.calendarSynced is bool &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidReview(data) {
      return data.userId is string &&
             data.userId == request.auth.uid &&
             data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 80 &&
             data.attractionId is string && data.attractionId.size() >= 1 && data.attractionId.size() <= 80 &&
             data.attractionName is string && data.attractionName.size() >= 1 && data.attractionName.size() <= 120 &&
             data.rating is int && data.rating >= 1 && data.rating <= 5 &&
             data.comment is string && data.comment.size() >= 3 && data.comment.size() <= 800 &&
             data.visitTag is string && data.visitTag.size() >= 1 && data.visitTag.size() <= 40 &&
             (!('photoData' in data) || (data.photoData is string && data.photoData.size() <= 65536)) &&
             (!('verifiedVisit' in data) || data.verifiedVisit is bool) &&
             (!('helpfulUserIds' in data) || (data.helpfulUserIds is list && data.helpfulUserIds.size() <= 200)) &&
             (!('adminReply' in data) || (data.adminReply is string && data.adminReply.size() <= 500)) &&
             (!('adminReplyBy' in data) || (data.adminReplyBy is string && data.adminReplyBy.size() <= 80)) &&
             data.visibility is string && data.visibility == 'public' &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidTourismEventType(eventType) {
      return eventType is string && eventType in ['FESTIVAL', 'MARKET_DAY', 'TRAIL_ADVISORY', 'WEATHER_ALERT', 'COMMUNITY'];
    }

    function isValidTourismEventSeverity(severity) {
      return severity is string && severity in ['INFO', 'ADVISORY', 'ALERT'];
    }

    function isValidTourismEvent(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.title is string && data.title.size() >= 2 && data.title.size() <= 120 &&
             data.summary is string && data.summary.size() >= 3 && data.summary.size() <= 500 &&
             isValidTourismEventType(data.eventType) &&
             isValidTourismEventSeverity(data.severity) &&
             data.dateLabel is string && data.dateLabel.size() >= 2 && data.dateLabel.size() <= 80 &&
             data.locationName is string && data.locationName.size() >= 2 && data.locationName.size() <= 120 &&
             (!('attractionId' in data) || (data.attractionId is string && data.attractionId.size() <= 80)) &&
             data.active is bool &&
             data.visibility is string && data.visibility == 'public' &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidTransitMethod(data) {
      return data.userId is string &&
             data.name is string && data.name.size() >= 2 && data.name.size() <= 120 &&
             isValidTransitMode(data.modeCategory) &&
             data.operatorName is string && data.operatorName.size() >= 2 && data.operatorName.size() <= 100 &&
             data.routeSummary is string && data.routeSummary.size() >= 3 && data.routeSummary.size() <= 240 &&
             data.scheduleText is string && data.scheduleText.size() >= 3 && data.scheduleText.size() <= 160 &&
             data.fareRangePhp is string && data.fareRangePhp.size() >= 1 && data.fareRangePhp.size() <= 60 &&
             data.durationText is string && data.durationText.size() >= 1 && data.durationText.size() <= 60 &&
             data.terminalLocation is string && data.terminalLocation.size() >= 2 && data.terminalLocation.size() <= 160 &&
             (!('travelTip' in data) || (data.travelTip is string && data.travelTip.size() <= 400)) &&
             isValidServiceStatus(data.serviceStatus) &&
             data.visibility is string && data.visibility == 'public' &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    match /users/{userId} {
      allow get, list: if isSignedIn() && (request.auth.uid == userId || isAdmin());

      allow create: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       incoming().keys().hasAll(['userId', 'displayName', 'preferredLanguage', 'offlinePackEnabled', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'email', 'role', 'displayName', 'photoData', 'favoriteAttractionIds', 'preferredLanguage', 'offlinePackEnabled', 'createdAt', 'updatedAt']) &&
                       (!('role' in incoming()) || incoming().role == 'regular') &&
                       isValidUserProfile(incoming());

      allow update: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       isValidUserProfile(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       !('role' in incoming().diff(existing()).affectedKeys()) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['email', 'displayName', 'photoData', 'favoriteAttractionIds', 'preferredLanguage', 'offlinePackEnabled', 'updatedAt']);

      allow delete: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;

      match /itineraries/{itineraryId} {
        allow get, list: if isSignedIn() && request.auth.uid == userId;

        allow create: if isSignedIn() &&
                         isValidId(userId) &&
                         isValidId(itineraryId) &&
                         request.auth.uid == userId &&
                         incoming().keys().hasAll(['userId', 'attractionId', 'attractionName', 'plannedDateMillis', 'reminderEnabled', 'calendarSynced', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'attractionId', 'attractionName', 'plannedDateMillis', 'notes', 'reminderEnabled', 'calendarSynced', 'createdAt', 'updatedAt']) &&
                         isValidItineraryItem(incoming());

        allow update: if isSignedIn() &&
                         isValidId(userId) &&
                         isValidId(itineraryId) &&
                         request.auth.uid == userId &&
                         isValidItineraryItem(incoming()) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['plannedDateMillis', 'notes', 'reminderEnabled', 'calendarSynced', 'updatedAt']);

        allow delete: if isSignedIn() && isValidId(userId) && isValidId(itineraryId) && request.auth.uid == userId;
      }
    }

    // Project operators maintain these documents through Firebase Console.
    match /admin_emails/{email} {
      allow get: if hasVerifiedEmail() && request.auth.token.email.lower() == email;
    }

    match /attractions/{attractionId} {
      allow get: if isSignedIn() && (existing().visibility == 'public' || isAdmin());
      allow list: if isSignedIn() && resource.data.visibility == 'public';

      allow create: if isAdmin() &&
                       isValidId(attractionId) &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll(['userId', 'mapNodeId', 'nameEn', 'subtitleEn', 'descriptionEn', 'barangay', 'category', 'latitude', 'longitude', 'openHours', 'entryFeeEn', 'bestTimeEn', 'transitHintEn', 'baseRating', 'imageKey', 'visibility', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'mapNodeId', 'nameEn', 'nameCeb', 'nameTl', 'nameEs', 'subtitleEn', 'descriptionEn', 'historyNoteEn', 'barangay', 'category', 'latitude', 'longitude', 'openHours', 'entryFeeEn', 'bestTimeEn', 'transitHintEn', 'baseRating', 'imageKey', 'photoData', 'galleryPhotos', 'visibility', 'createdAt', 'updatedAt']) &&
                       isValidAttraction(incoming());

      allow update: if isAdmin() &&
                       isValidId(attractionId) &&
                       isValidAttraction(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().visibility == existing().visibility &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['mapNodeId', 'nameEn', 'nameCeb', 'nameTl', 'nameEs', 'subtitleEn', 'descriptionEn', 'historyNoteEn', 'barangay', 'category', 'latitude', 'longitude', 'openHours', 'entryFeeEn', 'bestTimeEn', 'transitHintEn', 'baseRating', 'imageKey', 'photoData', 'galleryPhotos', 'updatedAt']);

      allow delete: if isAdmin() && isValidId(attractionId);
    }

    match /attraction_categories/{categoryId} {
      allow get: if isSignedIn() && (existing().visibility == 'public' || isAdmin());
      allow list: if isSignedIn() && resource.data.visibility == 'public';

      allow create: if isAdmin() &&
                       isValidId(categoryId) &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll(['userId', 'code', 'name', 'iconKey', 'sortOrder', 'visibility', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'code', 'name', 'iconKey', 'sortOrder', 'visibility', 'createdAt', 'updatedAt']) &&
                       isValidAttractionCategoryRecord(incoming());

      allow update: if isAdmin() &&
                       isValidId(categoryId) &&
                       isValidAttractionCategoryRecord(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().code == existing().code &&
                       incoming().visibility == existing().visibility &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['name', 'iconKey', 'sortOrder', 'updatedAt']);

      allow delete: if isAdmin() && isValidId(categoryId);
    }

    match /emergency_contacts/{contactId} {
      allow get: if isSignedIn() && (existing().visibility == 'public' || isAdmin());
      allow list: if isSignedIn() && resource.data.visibility == 'public';

      allow create: if isAdmin() &&
                       isValidId(contactId) &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll(['userId', 'titleEn', 'department', 'phoneNumber', 'availability', 'priorityLevel', 'visibility', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'titleEn', 'department', 'phoneNumber', 'availability', 'priorityLevel', 'email', 'websiteUrl', 'visibility', 'createdAt', 'updatedAt']) &&
                       isValidEmergencyContact(incoming());

      allow update: if isAdmin() &&
                       isValidId(contactId) &&
                       isValidEmergencyContact(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().visibility == existing().visibility &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['titleEn', 'department', 'phoneNumber', 'availability', 'priorityLevel', 'email', 'websiteUrl', 'updatedAt']);

      allow delete: if isAdmin() && isValidId(contactId);
    }

    match /reviews/{reviewId} {
      allow get: if isSignedIn() && (existing().visibility == 'public' || existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.visibility == 'public' || resource.data.userId == request.auth.uid);

      allow create: if isSignedIn() &&
                       isValidId(reviewId) &&
                       incoming().keys().hasAll(['userId', 'authorName', 'attractionId', 'attractionName', 'rating', 'comment', 'visitTag', 'visibility', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'authorName', 'attractionId', 'attractionName', 'rating', 'comment', 'visitTag', 'photoData', 'verifiedVisit', 'helpfulUserIds', 'visibility', 'createdAt', 'updatedAt']) &&
                       (!('helpfulUserIds' in incoming()) || incoming().helpfulUserIds.size() == 0) &&
                       isValidReview(incoming());

      allow update: if isSignedIn() && isValidId(reviewId) && (
        (
          existing().userId == request.auth.uid &&
          isValidReview(incoming()) &&
          incoming().userId == existing().userId &&
          incoming().attractionId == existing().attractionId &&
          incoming().attractionName == existing().attractionName &&
          incoming().visibility == existing().visibility &&
          incoming().createdAt == existing().createdAt &&
          incoming().diff(existing()).affectedKeys().hasOnly(['rating', 'comment', 'visitTag', 'photoData', 'updatedAt'])
        ) || (
          incoming().diff(existing()).affectedKeys().hasOnly(['helpfulUserIds', 'updatedAt']) &&
          incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
          incoming().helpfulUserIds is list && incoming().helpfulUserIds.size() <= 200 &&
          incoming().helpfulUserIds.toSet().difference(existing().get('helpfulUserIds', []).toSet()).hasOnly([request.auth.uid]) &&
          existing().get('helpfulUserIds', []).toSet().difference(incoming().helpfulUserIds.toSet()).hasOnly([request.auth.uid])
        ) || (
          isAdmin() &&
          incoming().diff(existing()).affectedKeys().hasOnly(['adminReply', 'adminReplyBy', 'updatedAt']) &&
          incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
          (!('adminReply' in incoming()) || (incoming().adminReply is string && incoming().adminReply.size() <= 500)) &&
          (!('adminReplyBy' in incoming()) || (incoming().adminReplyBy is string && incoming().adminReplyBy.size() <= 80))
        )
      );

      allow delete: if isSignedIn() && isValidId(reviewId) && (existing().userId == request.auth.uid || isAdmin());
    }

    match /tourism_events/{eventId} {
      allow get: if isSignedIn() && (existing().visibility == 'public' || isAdmin());
      allow list: if isSignedIn() && resource.data.visibility == 'public';

      allow create: if isAdmin() &&
                       isValidId(eventId) &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll(['userId', 'title', 'summary', 'eventType', 'severity', 'dateLabel', 'locationName', 'active', 'visibility', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'title', 'summary', 'eventType', 'severity', 'dateLabel', 'locationName', 'attractionId', 'active', 'visibility', 'createdAt', 'updatedAt']) &&
                       isValidTourismEvent(incoming());

      allow update: if isAdmin() &&
                       isValidId(eventId) &&
                       isValidTourismEvent(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().visibility == existing().visibility &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['title', 'summary', 'eventType', 'severity', 'dateLabel', 'locationName', 'attractionId', 'active', 'updatedAt']);

      allow delete: if isAdmin() && isValidId(eventId);
    }

    match /transit_methods/{transitId} {
      allow get: if isSignedIn() && (existing().visibility == 'public' || existing().userId == request.auth.uid);
      allow list: if isSignedIn() && (resource.data.visibility == 'public' || resource.data.userId == request.auth.uid);

      allow create: if isAdmin() && incoming().userId == request.auth.uid &&
                       isValidId(transitId) &&
                       incoming().keys().hasAll(['userId', 'name', 'modeCategory', 'operatorName', 'routeSummary', 'scheduleText', 'fareRangePhp', 'durationText', 'terminalLocation', 'serviceStatus', 'visibility', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'name', 'modeCategory', 'operatorName', 'routeSummary', 'scheduleText', 'fareRangePhp', 'durationText', 'terminalLocation', 'travelTip', 'serviceStatus', 'visibility', 'createdAt', 'updatedAt']) &&
                       isValidTransitMethod(incoming());

      allow update: if isAdmin() &&
                       isValidId(transitId) &&
                       isValidTransitMethod(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().visibility == existing().visibility &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['name', 'modeCategory', 'operatorName', 'routeSummary', 'scheduleText', 'fareRangePhp', 'durationText', 'terminalLocation', 'travelTip', 'serviceStatus', 'updatedAt']);

      allow delete: if isAdmin() && isValidId(transitId);
    }
  }
}

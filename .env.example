# OPENWEATHERMAP_API_KEY: Required for real-time Dumingag weather updates via OpenWeatherMap API.
# Configure this in the Secrets panel in AI Studio.
OPENWEATHERMAP_API_KEY=MY_OPENWEATHERMAP_API_KEY

# CLOUDINARY_URL: Required for cloud image storage & WebP compression of traveler reviews, attractions, and avatars.
# Format: cloudinary://<api_key>:<api_secret>@<cloud_name>
# Configure your real URL securely in the Secrets panel in AI Studio.
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
